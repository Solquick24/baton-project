# Local API settings. Copy to apps/api/.env and fill in. Never commit .env.
# Relative paths are resolved from the apps/api folder.

API_PORT=3001
# Required. At least 32 random characters.
JWT_SECRET=
SQLITE_PATH=./data/baton.sqlite
UPLOAD_DIR=./data/uploads
FIXTURES_DIR=../../fixtures

# Server "today" for the demo story (visits in Jan-Mar 2026). Log timestamps use the real clock.
DEMO_TODAY=2026-03-12

# fixture | live. Tests always use fixture.
LLM_MODE=fixture
STT_MODE=fixture
# When a live call fails, use the stored fixture for the same input and mark it as mode=fixture.
LIVE_FALLBACK_TO_FIXTURE=true
# Registers GET /api/__test/ai-calls. Enable only for e2e runs.
ENABLE_TEST_ENDPOINTS=false

# AWS is used only for Bedrock and Transcribe calls. No resources are created.
AWS_REGION=ap-northeast-2
AWS_PROFILE=
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5
# Existing bucket provided for the event, used only as temporary Transcribe staging. Leave empty to use the fixture transcript.
TRANSCRIBE_STAGING_BUCKET=
